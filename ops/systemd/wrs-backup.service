[Unit]
Description=WRS PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wrs
Group=wrs
EnvironmentFile=/etc/wrs/backup.env
ExecStart=/opt/wrs/current/ops/backup.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/wrs
