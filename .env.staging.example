# Copy to .env.staging on the staging VPS. Never commit the real file.
APP_ENV=staging
APP_VERSION=git-sha-or-release
PUBLIC_URL=https://staging.example.com
ENABLE_API_DOCS=false
STAGING_HOST=staging.example.com

SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVICE_KEY=replace-me
SUPABASE_ANON_KEY=replace-me
# Use the direct or session-pooler connection, not a transaction-pooler URL.
DATABASE_URL=postgresql://postgres:replace-me@db.project.supabase.co:5432/postgres

OPENAI_API_KEY=replace-me
EMBED_MODEL=intfloat/multilingual-e5-base
RAG_MODEL=gpt-4o-mini

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTHCHECK_TIMEOUT=5
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Optional application settings
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_ADMIN_NAME=Admin
TELEGRAM_BOT_TOKEN=
WHATSAPP_ENABLED=false
