# Supabase (required)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Direct or session-pooler connection used by migrations and backups
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Embedding / RAG
EMBED_MODEL=intfloat/multilingual-e5-base
OPENAI_API_KEY=sk-replace-me
RAG_MODEL=gpt-4o-mini
RAG_TOP_K=5

# Application
APP_ENV=development
APP_VERSION=dev
PUBLIC_URL=http://localhost:8090
# APP_ADMIN_EMAIL=owner@example.com
# APP_ADMIN_PASSWORD=change-me
# APP_ADMIN_NAME=Admin
# APP_SESSION_TTL_HOURS=720

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTHCHECK_TIMEOUT=5
# SENTRY_DSN=https://public-key@your-sentry-host/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional integrations
# TELEGRAM_BOT_TOKEN=123456:replace-me
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=alerts@example.com
# SMTP_PASSWORD=replace-me
# SMTP_FROM=alerts@example.com
# SMTP_USE_TLS=true
# WHATSAPP_ENABLED=false
# WHATSAPP_VERIFY_TOKEN=replace-me
# WHATSAPP_APP_SECRET=replace-me

# Trusted reverse proxies for X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1

# Runtime tuning
# THREAD_POOL_SIZE=4
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# REQUEST_DELAY=0.5
# THRESHOLD_HIGH=0.75
# THRESHOLD_MEDIUM=0.5
